# LLM 을 붙이면 CrewAI 5-에이전트 경로로 동작한다. 없으면 결정론적 폴백 경로로 동작한다.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# auto | anthropic | openai | none
HRX_LLM_PROVIDER=auto
# HRX_LLM_MODEL=anthropic/claude-sonnet-4-20250514

# 검색 파라미터
HRX_TOP_K=6
HRX_CANDIDATE_K=24

# 하네스 (컨텍스트 예산 / 근거 게이트)
HRX_CONTEXT_BUDGET=12000
HRX_MIN_CITATION_COVERAGE=0.6
HRX_MAX_REPAIRS=2

# 합성 데이터
HRX_SEED=20260915
HRX_HEADCOUNT=820
